{
  "extends": "../packages/contracts/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": false,
    "types": ["vite/client", "node", "@testing-library/jest-dom/vitest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@inferatlas/contracts": ["../packages/contracts/src/index.ts"],
      "@inferatlas/arch-ui": ["../packages/arch-ui/src/index.ts"]
    }
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "playwright.config.ts"]
}
