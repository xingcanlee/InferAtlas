  "dependencies": {
    "@inferatlas/contracts": "workspace:*",
    "ajv": "8.17.1",
    "elkjs": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "vitest": "3.2.4"
  }
}
