{
  "name": "inferatlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter '@inferatlas/*' -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "schemas": "uv run --project generator python -m inferatlas.schema.export && pnpm --filter @inferatlas/contracts gen",
    "site": "uv run --project generator inferatlas site",
    "single": "uv run --project generator inferatlas single"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "typescript": "5.9.3"
  }
}
